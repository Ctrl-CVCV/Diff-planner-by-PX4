common:
    lid_topic:  "/livox/lidar"
    imu_topic:  "/mavros/imu/data_raw"
    time_sync_en: false
    # Definition used by FAST-LIO: lidar timestamp + offset = IMU timestamp.
    # Calibrated by LI-Init on 2026-10-11; FAST-LIO subtracts this value from IMU stamps.
    time_offset_lidar_to_imu: -0.074816

preprocess:
    lidar_type: 1
    scan_line: 4
    blind: 0.5

mapping:
    acc_cov: 0.1
    gyr_cov: 0.1
    b_acc_cov: 0.0001
    b_gyr_cov: 0.0001
    fov_degree: 360
    det_range: 100.0
    # Keep false after copying the LI-Init calibration below.
    extrinsic_est_en: false
    # LiDAR pose expressed in the IMU body frame: p_I = R_LI * p_L + T_LI.
    # Refinement result from LiDAR_IMU_Init; p_I = R_LI * p_L + T_LI.
    extrinsic_T: [0.056315, 0.012985, 0.042733]
    extrinsic_R: [ 0.857484,  0.003882,  0.514495,
                   0.006413,  0.999813, -0.018231,
                  -0.514470,  0.018932,  0.857299]

publish:
    path_en: true
    scan_publish_en: true
    dense_publish_en: true
    scan_bodyframe_pub_en: true

pcd_save:
    pcd_save_en: true
    interval: 100
