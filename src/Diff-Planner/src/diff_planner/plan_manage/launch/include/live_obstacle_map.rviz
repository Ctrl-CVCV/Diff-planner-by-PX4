Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: world
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: World Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 30
    - Class: rviz/Odometry
      Name: EKF Position
      Enabled: true
      Topic: /ekf/ekf_odom
      Keep: 100
      Queue Size: 10
      Position Tolerance: 0.02
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 220; 80
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.06
        Head Radius: 0.025
    - Class: rviz/Marker
      Name: Position Occupancy Check
      Enabled: true
      Marker Topic: /map_position_check/state
      Queue Size: 2
    - Class: rviz/Marker
      Name: Optimized Trajectory
      Enabled: true
      Marker Topic: /drone_0_diff_planner_node/optimal_list
      Queue Size: 10
    - Class: rviz/Marker
      Name: Global Reference
      Enabled: true
      Marker Topic: /drone_0_diff_planner_node/global_list
      Queue Size: 10
    - Class: rviz/Marker
      Name: Initial Path
      Enabled: false
      Marker Topic: /drone_0_diff_planner_node/init_list
      Queue Size: 10
    - Class: rviz/Marker
      Name: A Star Search
      Enabled: false
      Marker Topic: /drone_0_diff_planner_node/a_star_list
      Queue Size: 10
    - Class: rviz/Marker
      Name: Failed Candidates
      Enabled: false
      Marker Topic: /drone_0_diff_planner_node/failed_list
      Queue Size: 10
    - Class: rviz/PointCloud2
      Name: Occupancy Raw
      Enabled: true
      Topic: /drone_0_diff_planner_node/grid_map/occupancy
      Queue Size: 1
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Alpha: 1
      Color Transformer: FlatColor
      Color: 255; 150; 40
    - Class: rviz/PointCloud2
      Name: Occupancy Inflated
      Enabled: true
      Topic: /drone_0_diff_planner_node/grid_map/occupancy_inflate
      Queue Size: 1
      Style: Boxes
      # One voxel is map_resolution = 0.08 m; use slightly smaller cubes so
      # neighbouring cells stay distinguishable and alpha blending stays clean.
      Size (m): 0.075
      Decay Time: 0
      Alpha: 0.35
      Color Transformer: FlatColor
      Color: 60; 170; 255
    - Class: rviz/PointCloud2
      Name: Registered Cloud Optional TF Required
      Enabled: false
      Topic: /cloud_registered
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Alpha: 0.5
      Color Transformer: FlatColor
      Color: 200; 200; 200
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Width: 1280
  Height: 800
