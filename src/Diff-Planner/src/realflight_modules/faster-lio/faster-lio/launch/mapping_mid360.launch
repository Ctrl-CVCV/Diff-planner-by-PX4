<launch>
  <arg name="config_file" default="$(find faster_lio)/config/mid360_px4.yaml"/>
  <arg name="start_lidar" default="false"/>
  <arg name="mapping_node_name" default="laserMapping"/>
  <arg name="odom_topic" default="/Odometry"/>
  <arg name="cloud_topic" default="/cloud_registered"/>
  <arg name="body_cloud_topic" default="/cloud_registered_body"/>
  <arg name="path_topic" default="/path"/>
  <arg name="rviz" default="false"/>

  <include if="$(arg start_lidar)" file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360s.launch"/>
  <rosparam command="load" file="$(arg config_file)"/>
  <param name="runtime_pos_log_enable" type="bool" value="false"/>

  <node pkg="faster_lio" type="run_mapping_online" name="$(arg mapping_node_name)" output="screen">
    <remap from="/laserMapping/odometry" to="$(arg odom_topic)"/>
    <remap from="/laserMapping/cloud_registered" to="$(arg cloud_topic)"/>
    <remap from="/laserMapping/cloud_registered_body" to="$(arg body_cloud_topic)"/>
    <remap from="/laserMapping/path" to="$(arg path_topic)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="lio_rviz"
        args="-d $(find faster_lio)/config/rviz/faster_lio.rviz" output="screen"/>
</launch>
